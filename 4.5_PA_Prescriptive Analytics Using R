# Step 10: Evaluate the Six Scenarios

settings <- list(
  "A: 7 nights, 100 reviews" =
    c(minimum_nights = 7, number_of_reviews = 100),

  "B: 1 night, 10 reviews" =
    c(minimum_nights = 1, number_of_reviews = 10),

  "C: 2 nights, 100 days available" =
    c(minimum_nights = 2, availability_365 = 100),

  "D: 14 nights, 300 days available" =
    c(minimum_nights = 14, availability_365 = 300),

  "E: 300 days available, 5 reviews" =
    c(availability_365 = 300, number_of_reviews = 5),

  "F: 100 days available, 200 reviews" =
    c(availability_365 = 100, number_of_reviews = 200)
)

scenario_results <- numeric(length(settings))
names(scenario_results) <- names(settings)

for (scenario in names(settings)) {
  adjusted_features <- colMeans(X)

  adjusted_features[names(settings[[scenario]])] <-
    settings[[scenario]]

  scenario_results[scenario] <- predict(
    model,
    as.data.frame(t(adjusted_features))
  )
}

display_markdown(sprintf(
  "### Scenario Results - %s - %s",
  student_id, todays_date
))

print(
  data.frame(
    Scenario = names(scenario_results),
    Predicted_Price = round(as.numeric(scenario_results), 2)
  ),
  row.names = FALSE
)


