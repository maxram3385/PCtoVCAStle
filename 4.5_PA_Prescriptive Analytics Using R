# Step 2: Load and Describe the Dataset

library(readxl)
library(IRdisplay)
library(randomForest)
library(ggplot2)

student_id <- "maxram3385"
todays_date <- Sys.Date()

file_path <- "C:/Files/Excel/Prescriptive_PythonR/AirbnbListings_v4.xlsx"
airbnb_df <- as.data.frame(read_excel(file_path))

display_markdown(sprintf(
  "### Load and Describe the Dataset - %s - %s",
  student_id, todays_date
))

print(summary(airbnb_df))
print(colSums(is.na(airbnb_df)))

# Remove rows missing values required by the model
features <- c("minimum_nights", "number_of_reviews", "availability_365")
required_columns <- c(features, "price")
airbnb_df <- airbnb_df[complete.cases(airbnb_df[, required_columns]), ]

# Replace availability outside 0–365 with the valid median
invalid <- airbnb_df$availability_365 < 0 |
  airbnb_df$availability_365 > 365

airbnb_df$availability_365[invalid] <- median(
  airbnb_df$availability_365[!invalid]
)


# Step 3: Calculate Feature Importances

X <- airbnb_df[, features]
y <- airbnb_df$price

set.seed(42)
model <- randomForest(X, y)

importances <- model$importance[, "IncNodePurity"]

feature_importance_df <- data.frame(
  Feature = names(importances),
  Importance = as.numeric(importances)
)

print(feature_importance_df)


# Step 4: Graph Feature Importances

print(
  ggplot(feature_importance_df,
         aes(x = reorder(Feature, Importance), y = Importance)) +
    geom_bar(stat = "identity") +
    coord_flip() +
    labs(
      x = "Feature",
      y = "Importance",
      title = sprintf(
        "Feature Importances - %s - %s",
        student_id, todays_date
      )
    )
)


# Step 5: Plot Feature Analysis

for (feature_to_analyze in names(X)) {
  feature_values <- seq(
    min(X[[feature_to_analyze]]),
    max(X[[feature_to_analyze]]),
    length.out = 100
  )

  results <- numeric(100)

  for (i in seq_along(feature_values)) {
    X_temp <- X
    X_temp[[feature_to_analyze]] <- feature_values[i]
    results[i] <- mean(predict(model, X_temp))
  }

  print(
    ggplot() +
      geom_line(
        aes(x = feature_values, y = results),
        color = "blue"
      ) +
      labs(
        x = feature_to_analyze,
        y = "Average Predicted Price ($)",
        title = sprintf(
          "Sensitivity Analysis: %s\n%s - %s",
          feature_to_analyze, student_id, todays_date
        )
      )
  )
}


# Step 6: Find Optimal Feature Values and Associated Price

objective_function <- function(feature_values) {
  X_temp <- X

  X_temp[] <- matrix(
    feature_values,
    nrow = nrow(X_temp),
    ncol = ncol(X_temp),
    byrow = TRUE
  )

  return(-mean(predict(model, X_temp)))
}

bounds <- matrix(
  c(sapply(X, min), sapply(X, max)),
  ncol = 2
)

# Uses the guided practice method; a global maximum is not guaranteed.
result <- optim(
  par = as.numeric(colMeans(X)),
  fn = objective_function,
  lower = bounds[, 1],
  upper = bounds[, 2],
  method = "L-BFGS-B"
)

display_markdown(sprintf(
  "### Optimization Results - %s - %s",
  student_id, todays_date
))

print(data.frame(
  Feature = names(X),
  Value = result$par
))

cat(
  "Predicted price from optimization: $",
  round(-result$value, 2), "\n"
)


