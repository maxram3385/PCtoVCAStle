MATCH
(c:Course {name: "CIS 150"}),
(s1:Student {name: "Alex Carter"}),
(s2:Student {name: "Jordan Lee"}),
(s3:Student {name: "Taylor Smith"}),
(s4:Student {name: "Morgan Davis"}),
(s5:Student {name: "Casey Brown"})
