# ============================================================
# Evaluate the Six Required Scenarios
# ============================================================

# These are specified values, not increases.
scenario_settings <- list(
  "A: 7 nights, 100 reviews" = list(
    minimum_nights = 7,
    number_of_reviews = 100
  ),
  "B: 1 night, 10 reviews" = list(
    minimum_nights = 1,
    number_of_reviews = 10
  ),
  "C: 2 nights, 100 days available" = list(
    minimum_nights = 2,
    availability_365 = 100
  ),
  "D: 14 nights, 300 days available" = list(
    minimum_nights = 14,
    availability_365 = 300
  ),
  "E: 300 days available, 5 reviews" = list(
    availability_365 = 300,
    number_of_reviews = 5
  ),
  "F: 100 days available, 200 reviews" = list(
    availability_365 = 100,
    number_of_reviews = 200
  )
)

# Hold unspecified features at their mean values
scenarios <- list()

for (scenario in names(scenario_settings)) {
  adjusted_features <- colMeans(X)

  for (feature in names(scenario_settings[[scenario]])) {
    adjusted_features[feature] <-
      scenario_settings[[scenario]][[feature]]
  }

  scenarios[[scenario]] <- adjusted_features
}

# Predict the price for each scenario
scenario_results <- numeric(length(scenarios))
names(scenario_results) <- names(scenarios)

for (scenario in names(scenarios)) {
  feature_values_df <- as.data.frame(
    t(scenarios[[scenario]])
  )

  scenario_results[scenario] <- mean(
    predict(model, feature_values_df)
  )
}

display_markdown(sprintf(
  "### Evaluate Six Scenarios - %s - %s",
  student_id, todays_date
))

display_markdown("#### Scenario Feature Values")
print(round(as.data.frame(do.call(rbind, scenarios)), 2))

display_markdown("#### Scenario Results")

scenario_results_df <- data.frame(
  Scenario = names(scenario_results),
  Predicted_Price = round(as.numeric(scenario_results), 2)
)

print(scenario_results_df, row.names = FALSE)
